{
  "name": "sleep-my-angel",
  "version": "1.9.0",
  "private": true,
  "description": "cozy sleep companion with rain, ambient frequencies, affirmations and night rituals",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/build.js --site-only && node scripts/serve.js --open",
    "serve": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "books": "node scripts/prepare-books.js",
    "audio:manifest": "node scripts/audio-manifest.js",
    "cap:sync": "node scripts/build.js && npx cap sync android"
  },
  "keywords": [
    "sleep",
    "player",
    "ambient",
    "meditation",
    "moodboard",
    "pinterest",
    "aesthetic"
  ],
  "author": "u3unicornios",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^40.8.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
